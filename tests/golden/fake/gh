#!/usr/bin/env python3
"""A stand-in for the `gh` command, for the golden build: GitHub as folders on disk.

``$FAKE_GH_ROOT`` holds one bare git repository per created repository
(``<owner>/<name>.git``), its settings (``<owner>/<name>.json``: visibility, description,
labels) and its releases (``<owner>/<name>.releases/<tag>/``: the notes and the assets). Every
call is appended to ``calls.jsonl``. A call it does not know is logged there and fails, so a
test sees exactly what publishing asked of GitHub. Standard library only.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("FAKE_GH_ROOT", "fake-github"))
LOGIN = os.environ.get("FAKE_GH_LOGIN", "octo-owner")


def log(argv: list[str], ok: bool) -> None:
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / "calls.jsonl").open("a") as f:
        f.write(json.dumps({"argv": argv, "ok": ok}) + "\n")


def opt(argv: list[str], name: str, default: str | None = None) -> str | None:
    if name in argv:
        i = argv.index(name)
        return argv[i + 1] if i + 1 < len(argv) else default
    for a in argv:
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return default


def meta_path(full: str) -> Path:
    return ROOT / f"{full}.json"


def meta(full: str) -> dict:
    p = meta_path(full)
    return json.loads(p.read_text()) if p.is_file() else {}


def save(full: str, m: dict) -> None:
    meta_path(full).parent.mkdir(parents=True, exist_ok=True)
    meta_path(full).write_text(json.dumps(m, indent=2))


def git(*args: str, cwd: Path | None = None) -> None:
    subprocess.run(["git", *args], cwd=cwd, check=True, capture_output=True)


def out(obj) -> None:
    print(obj if isinstance(obj, str) else json.dumps(obj))


def repo_create(argv: list[str]) -> int:
    full = argv[2]
    if meta(full):
        print(f"GraphQL: Name already exists on this account (createRepository)", file=sys.stderr)
        return 1
    bare = ROOT / f"{full}.git"
    bare.parent.mkdir(parents=True, exist_ok=True)
    git("init", "-q", "--bare", "-b", "main", str(bare))
    vis = "public" if "--public" in argv else "private"
    save(full, {"visibility": vis, "description": opt(argv, "--description") or "",
                "labels": [], "url": f"https://github.com/{full}"})
    src = opt(argv, "--source")
    if src:
        remote = opt(argv, "--remote", "origin")
        git("remote", "add", remote, str(bare), cwd=Path(src))
        if "--push" in argv:
            git("push", "-q", remote, "--all", cwd=Path(src))
            git("push", "-q", remote, "--tags", cwd=Path(src))
    out(f"https://github.com/{full}")
    return 0


def release_dir(full: str, tag: str) -> Path:
    return ROOT / f"{full}.releases" / tag


def release_create(argv: list[str]) -> int:
    tag, full = argv[2], opt(argv, "--repo")
    d = release_dir(full, tag)
    d.mkdir(parents=True, exist_ok=True)
    notes = opt(argv, "--notes") or ""
    nf = opt(argv, "--notes-file")
    if nf:
        notes = Path(nf).read_text()
    skip = {"--repo", "--title", "--notes", "--notes-file", "--target"}
    assets, i = [], 3
    while i < len(argv):
        if argv[i] in skip:
            i += 2
            continue
        if not argv[i].startswith("-"):
            assets.append(argv[i])
        i += 1
    for a in assets:
        shutil.copy(a.split("#", 1)[0], d)
    (d / "release.json").write_text(json.dumps({"tag": tag, "title": opt(argv, "--title"),
                                                "body": notes,
                                                "assets": [Path(a).name for a in assets]}))
    out(f"https://github.com/{full}/releases/tag/{tag}")
    return 0


def release_view(argv: list[str]) -> int:
    tag, full = argv[2], opt(argv, "--repo")
    p = release_dir(full, tag) / "release.json"
    if not p.is_file():
        print("release not found", file=sys.stderr)
        return 1
    rel = json.loads(p.read_text())
    out(rel["body"] if opt(argv, "-q") == ".body" or opt(argv, "--jq") == ".body" else rel)
    return 0


def release_edit(argv: list[str]) -> int:
    tag, full = argv[2], opt(argv, "--repo")
    p = release_dir(full, tag) / "release.json"
    rel = json.loads(p.read_text())
    if opt(argv, "--notes") is not None:
        rel["body"] = opt(argv, "--notes")
    p.write_text(json.dumps(rel))
    return 0


def api(argv: list[str]) -> int:
    path = next((a for a in argv[1:] if not a.startswith("-") and "/" in a or a == "user"), "")
    method = opt(argv, "-X", "GET")
    if path == "user":
        q = opt(argv, "-q") or opt(argv, "--jq")
        out(LOGIN if q == ".login" else {"login": LOGIN})
        return 0
    if path.startswith("repos/"):
        full = "/".join(path.split("/")[1:3])
        m = meta(full)
        if not m:
            print("HTTP 404: Not Found", file=sys.stderr)
            return 1
        rest = path.split("/")[3:]
        if method == "PATCH" and not rest:
            for a in argv:
                if a.startswith("visibility="):
                    m["visibility"] = a.split("=", 1)[1]
                if a.startswith("delete_branch_on_merge="):
                    m["delete_branch_on_merge"] = a.split("=", 1)[1]
            save(full, m)
            out({"full_name": full, "visibility": m["visibility"]})
            return 0
        if method in ("PUT", "POST", "PATCH", "DELETE"):
            m.setdefault("api", []).append([method, "/".join(rest)])
            save(full, m)
            out({})
            return 0
        if not rest:
            out({"full_name": full, "visibility": m["visibility"],
                 "private": m["visibility"] == "private", "html_url": m["url"]})
            return 0
        if rest == ["labels"]:
            out([{"name": n} for n in m.get("labels", [])])
            return 0
        out([])
        return 0
    return 2


def main() -> int:
    argv = sys.argv[1:]
    head = argv[:2]
    code = 2
    if argv[:1] == ["--version"]:
        out("gh version 2.45.0 (fake)")
        code = 0
    elif head == ["auth", "status"]:
        out(f"Logged in to github.com account {LOGIN}")
        code = 0
    elif head == ["repo", "create"]:
        code = repo_create(argv)
    elif head == ["repo", "view"]:
        full = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else ""
        m = meta(full)
        if m:
            out({"nameWithOwner": full, "visibility": m["visibility"].upper(), "url": m["url"]})
            code = 0
        else:
            print("GraphQL: Could not resolve to a Repository", file=sys.stderr)
            code = 1
    elif head == ["repo", "edit"]:
        full = argv[2]
        m = meta(full)
        if opt(argv, "--description") is not None:
            m["description"] = opt(argv, "--description")
        if "--visibility" in argv:
            m["visibility"] = opt(argv, "--visibility")
        save(full, m)
        code = 0
    elif head == ["release", "create"]:
        code = release_create(argv)
    elif head == ["release", "view"]:
        code = release_view(argv)
    elif head == ["release", "edit"]:
        code = release_edit(argv)
    elif head == ["label", "list"]:
        full = opt(argv, "--repo") or opt(argv, "-R")
        out([{"name": n, "color": "ededed", "description": ""} for n in meta(full).get("labels", [])])
        code = 0
    elif head == ["label", "create"]:
        full = opt(argv, "--repo") or opt(argv, "-R")
        m = meta(full)
        m.setdefault("labels", []).append(argv[2])
        save(full, m)
        code = 0
    elif argv[:1] == ["api"]:
        code = api(argv)
    log(argv, code == 0)
    if code == 2:
        print(f"fake gh: unknown call: {' '.join(argv)}", file=sys.stderr)
        return 1
    return code


if __name__ == "__main__":
    sys.exit(main())
