#!/usr/bin/env python3
"""A stand-in for the `gh` command, for the golden build: GitHub as folders on disk.

``$FAKE_GH_ROOT`` holds one bare git repository per created repository
(``<owner>/<name>.git``), its settings (``<owner>/<name>.json``: visibility, description,
labels) and its releases (``<owner>/<name>.releases/<tag>/``: the notes and the assets). Every
call is appended to ``calls.jsonl``. A call it does not know is logged there and fails, so a
test sees exactly what publishing asked of GitHub. Standard library only.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("FAKE_GH_ROOT", "fake-github"))
LOGIN = os.environ.get("FAKE_GH_LOGIN", "octo-owner")


def log(argv: list[str], ok: bool) -> None:
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / "calls.jsonl").open("a") as f:
        f.write(json.dumps({"argv": argv, "ok": ok}) + "\n")


def opt(argv: list[str], name: str, default: str | None = None) -> str | None:
    if name in argv:
        i = argv.index(name)
        return argv[i + 1] if i + 1 < len(argv) else default
    for a in argv:
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return default


def meta_path(full: str) -> Path:
    return ROOT / f"{full}.json"


def meta(full: str) -> dict:
    p = meta_path(full)
    return json.loads(p.read_text()) if p.is_file() else {}


def save(full: str, m: dict) -> None:
    meta_path(full).parent.mkdir(parents=True, exist_ok=True)
    meta_path(full).write_text(json.dumps(m, indent=2))


def git(*args: str, cwd: Path | None = None) -> None:
    subprocess.run(["git", *args], cwd=cwd, check=True, capture_output=True)


def out(obj) -> None:
    print(obj if isinstance(obj, str) else json.dumps(obj))


def repo_create(argv: list[str]) -> int:
    full = argv[2]
    if meta(full):
        print(f"GraphQL: Name already exists on this account (createRepository)", file=sys.stderr)
        return 1
    bare = ROOT / f"{full}.git"
    bare.parent.mkdir(parents=True, exist_ok=True)
    git("init", "-q", "--bare", "-b", "main", str(bare))
    vis = "public" if "--public" in argv else "private"
    save(full, {"visibility": vis, "description": opt(argv, "--description") or "",
                "labels": [], "url": f"https://github.com/{full}"})
    src = opt(argv, "--source")
    if src:
        remote = opt(argv, "--remote", "origin")
        git("remote", "add", remote, str(bare), cwd=Path(src))
        if "--push" in argv:
            git("push", "-q", remote, "--all", cwd=Path(src))
            git("push", "-q", remote, "--tags", cwd=Path(src))
    out(f"https://github.com/{full}")
    return 0


def release_dir(full: str, tag: str) -> Path:
    return ROOT / f"{full}.releases" / tag


def release_create(argv: list[str]) -> int:
    tag, full = argv[2], opt(argv, "--repo")
    d = release_dir(full, tag)
    d.mkdir(parents=True, exist_ok=True)
    notes = opt(argv, "--notes") or ""
    nf = opt(argv, "--notes-file")
    if nf:
        notes = Path(nf).read_text()
    skip = {"--repo", "--title", "--notes", "--notes-file", "--target"}
    assets, i = [], 3
    while i < len(argv):
        if argv[i] in skip:
            i += 2
            continue
        if not argv[i].startswith("-"):
            assets.append(argv[i])
        i += 1
    for a in assets:
        shutil.copy(a.split("#", 1)[0], d)
    (d / "release.json").write_text(json.dumps({"tag": tag, "title": opt(argv, "--title"),
                                                "body": notes,
                                                "assets": [Path(a).name for a in assets]}))
    out(f"https://github.com/{full}/releases/tag/{tag}")
    return 0


def release_view(argv: list[str]) -> int:
    tag, full = argv[2], opt(argv, "--repo")
    p = release_dir(full, tag) / "release.json"
    if not p.is_file():
        print("release not found", file=sys.stderr)
        return 1
    rel = json.loads(p.read_text())
    out(rel["body"] if opt(argv, "-q") == ".body" or opt(argv, "--jq") == ".body" else rel)
    return 0


def release_edit(argv: list[str]) -> int:
    tag, full = argv[2], opt(argv, "--repo")
    p = release_dir(full, tag) / "release.json"
    rel = json.loads(p.read_text())
    if opt(argv, "--notes") is not None:
        rel["body"] = opt(argv, "--notes")
    p.write_text(json.dumps(rel))
    return 0


def issue_read(path: str) -> int:
    """``repos/<owner>/<repo>/issues/<n>`` (and ``.../events``) from
    ``$FAKE_GH_ROOT/issues/<owner>/<repo>/<n>.json``: ``{"issue": {...}, "events": [...]}``.
    Issues are only read here: nothing is ever written to one by a read."""
    parts = path.split("?")[0].split("/")
    owner, repo, n = parts[1], parts[2], parts[4]
    f = ROOT / "issues" / owner / repo / f"{n}.json"
    if not f.is_file():
        print("gh: Not Found (HTTP 404)", file=sys.stderr)
        return 1
    data = json.loads(f.read_text())
    out(data.get("events", []) if parts[-1] == "events" else data["issue"])
    return 0


# -- maintenance: issues, pull requests and files, from folders and the local bare repository ----
def issues_dir(full: str) -> Path:
    return ROOT / "issues" / full


def all_items(full: str) -> list[dict]:
    d = issues_dir(full)
    items = []
    for f in sorted(d.glob("*.json")) if d.is_dir() else []:
        items.append(json.loads(f.read_text())["issue"])
    return items


def next_number(full: str) -> int:
    return 1 + max([int(i["number"]) for i in all_items(full)] or [0])


def write_item(full: str, item: dict, events: list | None = None) -> None:
    d = issues_dir(full)
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{item['number']}.json"
    old = json.loads(f.read_text()) if f.is_file() else {}
    f.write_text(json.dumps({"issue": item, "events": events if events is not None else old.get("events", [])}, indent=1))


def bare(full: str) -> Path:
    return ROOT / f"{full}.git"


def show(full: str, ref: str, path: str) -> str | None:
    p = subprocess.run(["git", "--git-dir", str(bare(full)), "show", f"{ref}:{path}"],
                       capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else None


def now_iso() -> str:
    import time
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def payload(argv: list[str]) -> dict:
    f = opt(argv, "--input")
    return json.loads(Path(f).read_text()) if f else {}


def maint_api(argv: list[str], path: str, method: str, full: str, rest: list[str]) -> int | None:
    """What maintenance asks of a repository; None: not one of these."""
    q = path.split("?", 1)[1] if "?" in path else ""
    rest = "/".join(rest).split("?")[0].split("/")
    raw = "application/vnd.github.raw" in " ".join(argv)
    if rest == ["issues"] and method == "GET":
        state = "all" if "state=all" in q else "open"
        out([i for i in all_items(full) if state == "all" or i.get("state", "open") == "open"])
        return 0
    if rest == ["issues"] and method == "POST":
        b = payload(argv)
        n = next_number(full)
        item = {"number": n, "title": b.get("title", ""), "body": b.get("body", ""),
                "user": {"login": LOGIN}, "author_association": "OWNER", "state": "open",
                "labels": [{"name": x} for x in b.get("labels") or []], "assignees": [],
                "comments": 0, "created_at": now_iso(), "updated_at": now_iso(),
                "html_url": f"https://github.com/{full}/issues/{n}"}
        events = [{"event": "labeled", "label": {"name": x}, "actor": {"login": LOGIN},
                   "created_at": now_iso()}
                  for x in b.get("labels") or []]
        write_item(full, item, events)
        out(item)
        return 0
    if rest == ["pulls"] and method == "POST":
        b = payload(argv)
        n = next_number(full)
        sha = subprocess.run(["git", "--git-dir", str(bare(full)), "rev-parse", b["head"]],
                             capture_output=True, text=True).stdout.strip()
        item = {"number": n, "title": b.get("title", ""), "body": b.get("body", ""),
                "user": {"login": LOGIN}, "author_association": "OWNER", "state": "open",
                "labels": [], "assignees": [], "comments": 0, "draft": bool(b.get("draft")),
                "created_at": now_iso(), "updated_at": now_iso(), "pull_request": {},
                "head": {"ref": b["head"], "sha": sha, "repo": {"full_name": full}},
                "base": {"ref": b.get("base", "main")},
                "html_url": f"https://github.com/{full}/pull/{n}"}
        write_item(full, item, [])
        out(item)
        return 0
    if len(rest) == 3 and rest[0] == "issues" and rest[2] == "labels" and method == "POST":
        f = issues_dir(full) / f"{rest[1]}.json"
        data = json.loads(f.read_text())
        have = [x["name"] for x in data["issue"]["labels"]]
        add = [x for x in payload(argv).get("labels") or [] if x not in have]
        data["issue"]["labels"] += [{"name": x} for x in add]
        data["events"] += [{"event": "labeled", "label": {"name": x}, "actor": {"login": LOGIN},
                            "created_at": now_iso()}
                           for x in add]
        f.write_text(json.dumps(data, indent=1))
        out(data["issue"]["labels"])
        return 0
    if len(rest) == 2 and rest[0] == "pulls" and method == "GET":
        f = issues_dir(full) / f"{rest[1]}.json"
        if not f.is_file():
            print("gh: Not Found (HTTP 404)", file=sys.stderr)
            return 1
        out({**json.loads(f.read_text())["issue"], "mergeable": True, "mergeable_state": "clean"})
        return 0
    if rest[:1] == ["contents"] and method == "GET":
        text = show(full, (q.split("ref=")[1].split("&")[0] if "ref=" in q else "main"),
                    "/".join(rest[1:]))
        if text is None:
            print("gh: Not Found (HTTP 404)", file=sys.stderr)
            return 1
        print(text, end="")
        return 0
    if rest == ["readme"]:
        for name in ("README.md", "README.rst", "README"):
            text = show(full, "main", name)
            if text is not None:
                print(text, end="")
                return 0
        print("gh: Not Found (HTTP 404)", file=sys.stderr)
        return 1
    if rest[:2] == ["commits", "main"] and len(rest) == 2:
        sha = subprocess.run(["git", "--git-dir", str(bare(full)), "rev-parse", "main"],
                             capture_output=True, text=True).stdout.strip()
        if "-i" in argv:
            print(f"HTTP/2.0 200 OK\nEtag: W/\"{sha}\"\n\n{sha}")
        else:
            out({"sha": sha})
        return 0
    if rest[:2] == ["git", "trees"]:
        p = subprocess.run(["git", "--git-dir", str(bare(full)), "ls-tree", "-r", "-t", rest[2]],
                           capture_output=True, text=True)
        tree = []
        for ln in p.stdout.splitlines():
            meta_, name = ln.split("\t", 1)
            kind = meta_.split()[1]
            tree.append({"path": name, "type": "tree" if kind == "tree" else "blob"})
        out({"tree": tree, "truncated": False})
        return 0
    if rest[:1] == ["releases"] or rest[:1] == ["tags"]:
        if rest == ["releases", "latest"]:
            print("gh: Not Found (HTTP 404)", file=sys.stderr)
            return 1
        out([])
        return 0
    if method == "GET" and raw:
        print("gh: Not Found (HTTP 404)", file=sys.stderr)
        return 1
    return None


def graphql(argv: list[str]) -> int:
    """The one query maintenance makes: when an issue's body was last edited, and by whom
    (``lastEditedAt``, ``editor``), from the issue file's ``edited`` (``issue edit`` writes it)."""
    q = payload(argv)
    v = q.get("variables") or {}
    f = ROOT / "issues" / str(v.get("owner")) / str(v.get("name")) / f"{v.get('n')}.json"
    if "lastEditedAt" not in str(q.get("query")) or not f.is_file():
        print("gh: GraphQL: Could not resolve to an Issue", file=sys.stderr)
        return 1
    e = json.loads(f.read_text()).get("edited") or {}
    got = {"lastEditedAt": e.get("at"), "editor": {"login": e["by"]} if e.get("by") else None}
    out({"data": {"repository": {"issue": got}}})
    return 0


def issue_edit(argv: list[str]) -> int:
    """``issue edit N --repo R [--title T] [--body B]``, as ``$FAKE_GH_AS`` (default the
    login): a title change is a ``renamed`` event, a body change the issue's ``edited``."""
    full, n = opt(argv, "--repo") or opt(argv, "-R"), argv[2]
    f = issues_dir(full) / f"{n}.json"
    if not f.is_file():
        print("gh: Not Found (HTTP 404)", file=sys.stderr)
        return 1
    data = json.loads(f.read_text())
    who = os.environ.get("FAKE_GH_AS") or LOGIN
    title, body = opt(argv, "--title"), opt(argv, "--body")
    if title is not None:
        data.setdefault("events", []).append(
            {"event": "renamed", "actor": {"login": who}, "created_at": now_iso(),
             "rename": {"from": data["issue"].get("title", ""), "to": title}})
        data["issue"]["title"] = title
    if body is not None:
        data["issue"]["body"] = body
        data["edited"] = {"at": now_iso(), "by": who}
    data["issue"]["updated_at"] = now_iso()
    f.write_text(json.dumps(data, indent=1))
    out(data["issue"]["html_url"] if data["issue"].get("html_url") else f"#{n}")
    return 0


def api(argv: list[str]) -> int:
    takes = {"-H", "-X", "--input", "-q", "--jq", "-F", "-f", "--method", "--header"}
    words = [a for i, a in enumerate(argv[1:], 1) if argv[i - 1] not in takes]
    if "graphql" in words:
        return graphql(argv)
    path = next((a for a in words if not a.startswith("-") and "/" in a or a == "user"), "")
    method = opt(argv, "-X", "GET")
    if path == "user":
        q = opt(argv, "-q") or opt(argv, "--jq")
        out(LOGIN if q == ".login" else {"login": LOGIN})
        return 0
    if path.startswith("repos/") and "/issues/" in path and method == "GET":
        return issue_read(path)
    if path.startswith("repos/"):
        full = "/".join(path.split("/")[1:3])
        m = meta(full)
        if not m:
            print("HTTP 404: Not Found", file=sys.stderr)
            return 1
        rest = path.split("/")[3:]
        got = maint_api(argv, path, method, full, rest)
        if got is not None:
            return got
        if method == "PATCH" and not rest:
            for a in argv:
                if a.startswith("visibility="):
                    m["visibility"] = a.split("=", 1)[1]
                if a.startswith("delete_branch_on_merge="):
                    m["delete_branch_on_merge"] = a.split("=", 1)[1]
            save(full, m)
            out({"full_name": full, "visibility": m["visibility"]})
            return 0
        if method in ("PUT", "POST", "PATCH", "DELETE"):
            m.setdefault("api", []).append([method, "/".join(rest)])
            save(full, m)
            out({})
            return 0
        if not rest:
            out({"full_name": full, "visibility": m["visibility"],
                 "private": m["visibility"] == "private", "html_url": m["url"]})
            return 0
        if rest == ["labels"]:
            out([{"name": n} for n in m.get("labels", [])])
            return 0
        out([])
        return 0
    return 2


def main() -> int:
    argv = sys.argv[1:]
    head = argv[:2]
    code = 2
    if argv[:1] == ["--version"]:
        out("gh version 2.45.0 (fake)")
        code = 0
    elif head == ["auth", "status"]:
        out(f"Logged in to github.com account {LOGIN}")
        code = 0
    elif head == ["repo", "create"]:
        code = repo_create(argv)
    elif head == ["repo", "view"]:
        full = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else ""
        m = meta(full)
        if m and opt(argv, "-q") == ".isPrivate":
            out("true" if m["visibility"] == "private" else "false")
            code = 0
        elif m:
            out({"nameWithOwner": full, "visibility": m["visibility"].upper(), "url": m["url"]})
            code = 0
        else:
            print("GraphQL: Could not resolve to a Repository", file=sys.stderr)
            code = 1
    elif head == ["repo", "clone"]:
        dest = argv[3] if len(argv) > 3 and argv[3] != "--" else Path(argv[2]).name
        subprocess.run(["git", "clone", "-q", str(bare(argv[2])), dest], check=True,
                       capture_output=True)
        code = 0
    elif head == ["pr", "list"]:
        full, ref = opt(argv, "--repo"), opt(argv, "--head")
        out([{"number": i["number"], "url": i["html_url"]} for i in all_items(full)
             if "pull_request" in i and i.get("state") == "open"
             and (i.get("head") or {}).get("ref") == ref])
        code = 0
    elif head == ["pr", "create"]:
        full = opt(argv, "--repo")
        n = next_number(full)
        ref = opt(argv, "--head")
        sha = subprocess.run(["git", "--git-dir", str(bare(full)), "rev-parse", ref],
                             capture_output=True, text=True).stdout.strip()
        item = {"number": n, "title": opt(argv, "--title") or "",
                "body": Path(opt(argv, "--body-file")).read_text() if opt(argv, "--body-file") else "",
                "user": {"login": LOGIN}, "author_association": "OWNER", "state": "open",
                "labels": [{"name": opt(argv, "--label")}] if opt(argv, "--label") else [],
                "assignees": [], "comments": 0, "created_at": now_iso(), "updated_at": now_iso(),
                "pull_request": {}, "head": {"ref": ref, "sha": sha, "repo": {"full_name": full}},
                "html_url": f"https://github.com/{full}/pull/{n}"}
        write_item(full, item, [])
        out(item["html_url"])
        code = 0
    elif head == ["repo", "edit"]:
        full = argv[2]
        m = meta(full)
        if opt(argv, "--description") is not None:
            m["description"] = opt(argv, "--description")
        if "--visibility" in argv:
            m["visibility"] = opt(argv, "--visibility")
        save(full, m)
        code = 0
    elif head == ["release", "create"]:
        code = release_create(argv)
    elif head == ["release", "view"]:
        code = release_view(argv)
    elif head == ["release", "edit"]:
        code = release_edit(argv)
    elif head == ["label", "list"]:
        full = opt(argv, "--repo") or opt(argv, "-R")
        out([{"name": n, "color": "ededed", "description": ""} for n in meta(full).get("labels", [])])
        code = 0
    elif head == ["label", "create"]:
        full = opt(argv, "--repo") or opt(argv, "-R")
        m = meta(full)
        if argv[2] not in m.setdefault("labels", []):
            m["labels"].append(argv[2])
        save(full, m)
        code = 0
    elif head == ["issue", "edit"]:
        code = issue_edit(argv)
    elif argv[:1] == ["api"]:
        code = api(argv)
    log(argv, code == 0)
    if code == 2:
        print(f"fake gh: unknown call: {' '.join(argv)}", file=sys.stderr)
        return 1
    return code


if __name__ == "__main__":
    sys.exit(main())
